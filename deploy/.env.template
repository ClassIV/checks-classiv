# checks.classiv.com — Railway environment variables
# Copy these into Railway service env. Values marked <SECRET> are populated
# from 1Password / generated. DO NOT commit filled-in values.

# === Core ===
SECRET_KEY=<SECRET: generated 67-char token, see deploy/.secrets-generated>
DEBUG=False
ALLOWED_HOSTS=checks.classiv.com
SITE_ROOT=https://checks.classiv.com
PING_ROOT=https://checks.classiv.com/ping
SITE_NAME=Class IV Checks
SITE_LOGO_URL=
REGISTRATION_OPEN=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# === Database (Neon, pooled) ===
DATABASE_URL=<SECRET: Neon pooled connection string with -pooler host>

# === Email (SMTP2GO Class IV — required for magic-link auth) ===
EMAIL_HOST=mail.smtp2go.com
EMAIL_PORT=2525
EMAIL_USE_TLS=True
EMAIL_USE_VERIFICATION=True
EMAIL_HOST_USER=<SECRET: from 1P "SMTP2GO (Class IV)" / username>
EMAIL_HOST_PASSWORD=<SECRET: from 1P "SMTP2GO (Class IV)" / password>
DEFAULT_FROM_EMAIL=checks@classiv.com
SUPPORT_EMAIL=becker@classiv.com

# === Notification channels: enabled ===
SLACK_ENABLED=True
TELEGRAM_ENABLED=True
TELEGRAM_TOKEN=<SECRET: BotFather token — user must mint>
TELEGRAM_BOT_NAME=ClassIVChecksBot
WEBHOOKS_ENABLED=True

# === Notification channels: explicitly disabled (locked-down posture) ===
APPRISE_ENABLED=False
DISCORD_ENABLED=False
GITHUB_ENABLED=False
GOTIFY_ENABLED=False
LINENOTIFY_ENABLED=False
MATRIX_ENABLED=False
MATTERMOST_ENABLED=False
MSTEAMS_ENABLED=False
NTFY_ENABLED=False
OPSGENIE_ENABLED=False
PAGERTREE_ENABLED=False
PD_ENABLED=False
PROMETHEUS_ENABLED=False
PUSHBULLET_ENABLED=False
PUSHOVER_API_TOKEN=
ROCKETCHAT_ENABLED=False
SHELL_ENABLED=False
SIGNAL_CLI_SOCKET=
SPIKE_ENABLED=False
TRELLO_APP_KEY=
TWILIO_AUTH=
VICTOROPS_ENABLED=False
ZULIP_ENABLED=False

# === Misc ===
USE_PAYMENTS=False
INTEGRATIONS_ALLOW_PRIVATE_IPS=False
PYTHONUNBUFFERED=1
